#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""pudctl -- inspect the pud module artifact and its runtime nodes.

This is a TOOL, not a test: it reports facts (vermagic, dependencies, sysfs
nodes) and never decides PASS/FAIL about project behaviour; tests own the
oracles (see tests/README.md).

    pudctl modinfo [--ko PATH] [--json]
    pudctl vermagic [--ko PATH] [--kernel REL] [--json]
    pudctl params [--json]
    pudctl nodes [--json]
    pudctl status [--json]

Exit codes (workspace convention):
    0 OK   1 FAIL   2 INVALID_USAGE   3 ENVIRONMENT_ERROR
"""

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys

VERSION = "1.0.0"

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_ENV = 0, 1, 2, 3

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MODULE = os.environ.get("MODULE", "pud")


def default_ko():
    return os.environ.get("PUD_KO", os.path.join(REPO, "pud.ko"))


def uname_r():
    return os.uname().release


def modinfo_field(ko, field):
    if not shutil.which("modinfo"):
        raise EnvironmentError("modinfo not found (install kmod)")
    try:
        out = subprocess.run(["modinfo", "-F", field, ko],
                             capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        raise EnvironmentError("modinfo timed out")
    if out.returncode != 0:
        raise EnvironmentError(out.stderr.strip() or "modinfo failed")
    return out.stdout.strip()


def collect_modinfo(ko):
    fields = ["name", "filename", "vermagic", "srcversion", "depends",
              "alias", "parm"]
    info = {}
    for field in fields:
        try:
            info[field] = modinfo_field(ko, field)
        except EnvironmentError:
            continue
    if "vermagic" not in info:
        raise EnvironmentError(f"no vermagic in {ko}")
    return info


def cmd_modinfo(args):
    ko = args.ko or default_ko()
    if not os.path.exists(ko):
        print(f"pudctl: no module at {ko}", file=sys.stderr)
        return EXIT_ENV
    try:
        info = collect_modinfo(ko)
    except EnvironmentError as exc:
        print(f"pudctl: {exc}", file=sys.stderr)
        return EXIT_ENV
    body = {"tool": "pudctl", "version": VERSION, "ko": ko,
            "observation": info}
    if args.json:
        print(json.dumps(body, indent=2))
    else:
        for k, v in info.items():
            if k == "parm":
                for line in (v.splitlines() or [""]):
                    print(f"{k:12} {line}")
            elif v:
                print(f"{k:12} {v}")
    return EXIT_OK


def cmd_vermagic(args):
    ko = args.ko or default_ko()
    kernel = args.kernel or uname_r()
    if not os.path.exists(ko):
        print(f"pudctl: no module at {ko}", file=sys.stderr)
        return EXIT_ENV
    try:
        vm = modinfo_field(ko, "vermagic")
    except EnvironmentError as exc:
        print(f"pudctl: {exc}", file=sys.stderr)
        return EXIT_ENV
    vm_rel = vm.split()[0] if vm else ""
    match = vm_rel == kernel
    status = "PASS" if match else "FAIL"
    body = {"tool": "pudctl", "version": VERSION, "status": status,
            "ko": ko,
            "observation": {"module_vermagic": vm,
                            "module_kernel_release": vm_rel,
                            "running_kernel_release": kernel}}
    if args.json:
        print(json.dumps(body, indent=2))
    else:
        print(f"vermagic  {vm}   (running kernel: {kernel})")
        print(f"[RESULT] {status}")
    return EXIT_OK if match else EXIT_FAIL


def read_params():
    base = f"/sys/module/{MODULE}/parameters"
    if not os.path.isdir(base):
        return None
    params = {}
    for path in sorted(glob.glob(os.path.join(base, "*"))):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                params[os.path.basename(path)] = fh.read().strip()
        except OSError:
            params[os.path.basename(path)] = None
    return params


def read_nodes():
    connectors, fbs = [], []
    for path in sorted(glob.glob("/sys/class/drm/card*-USB-*")):
        status_p = os.path.join(path, "status")
        enabled_p = os.path.join(path, "enabled")
        if not os.path.exists(status_p):
            continue
        entry = {"path": path}
        for key, p in (("status", status_p), ("enabled", enabled_p)):
            try:
                with open(p, "r", encoding="utf-8") as fh:
                    entry[key] = fh.read().strip()
            except OSError:
                entry[key] = None
        connectors.append(entry)
    for path in sorted(glob.glob("/sys/class/graphics/fb*")):
        name_p = os.path.join(path, "name")
        try:
            with open(name_p, "r", encoding="utf-8") as fh:
                name = fh.read().strip()
        except OSError:
            continue
        if name == "pud-drmdrmfb":
            fbs.append({"path": path, "name": name})
    return connectors, fbs


def cmd_params(args):
    params = read_params()
    if params is None:
        print(f"pudctl: /sys/module/{MODULE} is not present (module not "
              f"loaded?)", file=sys.stderr)
        return EXIT_ENV
    body = {"tool": "pudctl", "version": VERSION,
            "observation": {"module": MODULE, "parameters": params}}
    if args.json:
        print(json.dumps(body, indent=2))
    else:
        for k, v in params.items():
            print(f"{k}={v}")
    return EXIT_OK


def cmd_nodes(args):
    connectors, fbs = read_nodes()
    if not connectors and not fbs:
        print("pudctl: no pud DRM connector or framebuffer node (module not "
              "loaded, or loaded with input_only=1)", file=sys.stderr)
        return EXIT_ENV
    body = {"tool": "pudctl", "version": VERSION,
            "observation": {"connectors": connectors, "framebuffers": fbs}}
    if args.json:
        print(json.dumps(body, indent=2))
    else:
        for c in connectors:
            print(f"{c['path']}: {c.get('status')} {c.get('enabled')}")
        for f in fbs:
            print(f"{f['path']} = {f['name']}")
    return EXIT_OK


def cmd_status(args):
    body = {"tool": "pudctl", "version": VERSION,
            "observation": {"module": MODULE, "running_kernel": uname_r()}}
    loaded = os.path.isdir(f"/sys/module/{MODULE}")
    body["observation"]["loaded"] = loaded
    if loaded:
        body["observation"]["parameters"] = read_params() or {}
        refcnt = f"/sys/module/{MODULE}/refcnt"
        try:
            with open(refcnt, "r", encoding="utf-8") as fh:
                body["observation"]["refcnt"] = int(fh.read().strip())
        except (OSError, ValueError):
            body["observation"]["refcnt"] = None
        connectors, fbs = read_nodes()
        body["observation"]["connectors"] = connectors
        body["observation"]["framebuffers"] = fbs
    if args.json:
        print(json.dumps(body, indent=2))
    else:
        print(f"module      : {MODULE}")
        print(f"loaded      : {'yes' if loaded else 'no'}")
        if loaded:
            print(f"refcnt      : {body['observation'].get('refcnt')}")
            for k, v in body["observation"].get("parameters", {}).items():
                print(f"  {k}={v}")
            for c in body["observation"].get("connectors", []):
                print(f"  {c['path']}: {c.get('status')} {c.get('enabled')}")
            for f in body["observation"].get("framebuffers", []):
                print(f"  {f['path']} = {f['name']}")
    # A module that is simply not loaded is a normal observation, not an error.
    return EXIT_OK


def main(argv):
    parser = argparse.ArgumentParser(
        prog="pudctl", description="pud module inspector")
    parser.add_argument("--version", action="version",
                        version=f"pudctl {VERSION}")
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("modinfo", help="module metadata")
    p.add_argument("--ko", default=None)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_modinfo)

    p = sub.add_parser("vermagic", help="module vs kernel release")
    p.add_argument("--ko", default=None)
    p.add_argument("--kernel", default=None)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_vermagic)

    p = sub.add_parser("params", help="module parameters (needs the module)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_params)

    p = sub.add_parser("nodes", help="pud DRM/fb nodes (needs the module)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_nodes)

    p = sub.add_parser("status", help="aggregate runtime status")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help(sys.stderr)
        return EXIT_USAGE
    try:
        return args.func(args)
    except EnvironmentError as exc:
        print(f"pudctl: {exc}", file=sys.stderr)
        return EXIT_ENV


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
